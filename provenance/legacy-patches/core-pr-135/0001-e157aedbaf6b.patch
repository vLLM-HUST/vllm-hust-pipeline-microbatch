+        return False
+
+    def make_cache_stats(self):
+        return None
+
+
+def _create_pp_opt_scheduler(
+    *,
+    max_num_seqs: int = 16,
+    max_num_batched_tokens: int = 8192,
+    num_blocks: int = 10000,
+    block_size: int = 16,
