+export KV_CACHE_MEMORY ENFORCE_EAGER MAX_BATCHED_TOKENS TRACE_FILE MODEL_DIR
+export SHARE_DUMMY_WEIGHTS CONFIG_KEY CONFIG_PATH CONFIG_SHA256
