+
+@pytest.fixture(autouse=True)
+def enable_pp_opt_scheduler(monkeypatch):
+    monkeypatch.setenv("VLLM_USE_PP_OPT_SCHEDULER", "1")
+
+
+class _FakeMMRegistry:
